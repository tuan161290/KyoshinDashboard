{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KyoshinDb": "Data Source=Kyoshin.db"
  },
  "Ingest": {
    "ApiKey": "",
    "AllowedIps": "",
    "AgentOfflineSeconds": 30
  },
  "DataSettings": {
    "RetentionDays": 0
  },
  "Errors": {
    "OnlyWhenGreenOrYellow": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}