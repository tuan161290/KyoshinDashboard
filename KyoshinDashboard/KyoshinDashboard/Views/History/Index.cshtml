@{
    ViewData["Title"] = "Lịch sử máy";
}

<div class="page-header">
    <h1>📋 Lịch sử trạng thái máy</h1>
    <div class="filter-controls">
        <label>Máy:
            <select id="histMachineId" onchange="loadHistory()">
                @for (int i = 1; i <= MachineMonitorService.TOTAL_MACHINES; i++)
                {
                    <option value="@i" selected="@(ViewBag.MachineId == i)">M@(i)</option>
                }
            </select>
        </label>
        <label>Ngày: <input type="date" id="histDate" value="@ViewBag.Date" onchange="loadHistory()" /></label>
        <label>Từ: <span class="time24"><select id="histFromH" onchange="loadHistory()"></select>:<select id="histFromM" onchange="loadHistory()"></select></span></label>
        <label>Đến: <span class="time24"><select id="histToH" onchange="loadHistory()"></select>:<select id="histToM" onchange="loadHistory()"></select></span></label>
        <span class="range-btns">
            <button type="button" class="range-btn" data-range="06:00-06:00">Cả ngày</button>
            <button type="button" class="range-btn" data-range="06:00-14:00">Ca 1</button>
            <button type="button" class="range-btn" data-range="14:00-22:00">Ca 2</button>
            <button type="button" class="range-btn" data-range="22:00-06:00">Ca 3</button>
        </span>
        <span class="filter-error" id="histRangeError"></span>
    </div>
</div>

<div class="history-content">
    <!-- Charts stack (same style as dashboard) -->
    <div class="charts-stack">
        <div class="chart-container-sm chart-status-lg">
            <h3>
                <svg class="w11-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="2" y="2" width="20" height="20" rx="4.5" fill="url(#w11-h-status-bg)" opacity="0.08"/>
                    <rect x="2.5" y="2.5" width="19" height="19" rx="4" stroke="url(#w11-h-status-border)" stroke-width="1" opacity="0.15"/>
                    <rect x="6" y="11" width="3.5" height="7" rx="1.75" fill="url(#w11-h-status-bar1)"/>
                    <rect x="11" y="6" width="3.5" height="12" rx="1.75" fill="url(#w11-h-status-bar2)"/>
                    <rect x="16" y="9" width="3.5" height="9" rx="1.75" fill="url(#w11-h-status-bar3)"/>
                    <defs>
                        <linearGradient id="w11-h-status-bg" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#60CDFF"/>
                            <stop offset="100%" stop-color="#0078D4"/>
                        </linearGradient>
                        <linearGradient id="w11-h-status-border" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#ffffff"/>
                            <stop offset="100%" stop-color="#0078D4"/>
                        </linearGradient>
                        <linearGradient id="w11-h-status-bar1" x1="6" y1="11" x2="9.5" y2="18" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#9AD3FF"/>
                            <stop offset="100%" stop-color="#0078D4"/>
                        </linearGradient>
                        <linearGradient id="w11-h-status-bar2" x1="11" y1="6" x2="14.5" y2="18" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#60CDFF"/>
                            <stop offset="100%" stop-color="#005A9E"/>
                        </linearGradient>
                        <linearGradient id="w11-h-status-bar3" x1="16" y1="9" x2="19.5" y2="18" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#2899FF"/>
                            <stop offset="100%" stop-color="#004578"/>
                        </linearGradient>
                    </defs>
                </svg>
                <span>Trạng thái hoạt động</span>
            </h3>
            <div class="chart-canvas-wrapper">
                <canvas id="historyStatusChart"></canvas>
            </div>
        </div>
        <div class="chart-container-sm chart-error-sm">
            <h3 id="labelOut">
                <span class="chart-dot dot-out"></span>
                <span>@ErrorNames.Full(ErrorType.Out)</span>
            </h3>
            <div class="chart-canvas-wrapper">
                <canvas id="histOutChart"></canvas>
            </div>
        </div>
        <div class="chart-container-sm chart-error-sm">
            <h3 id="labelTrash">
                <span class="chart-dot dot-trash"></span>
                <span>@ErrorNames.Full(ErrorType.Trash)</span>
            </h3>
            <div class="chart-canvas-wrapper">
                <canvas id="histTrashChart"></canvas>
            </div>
        </div>
        <div class="chart-container-sm chart-error-sm">
            <h3 id="labelOther">
                <span class="chart-dot dot-other"></span>
                <span>@ErrorNames.Full(ErrorType.Other)</span>
            </h3>
            <div class="chart-canvas-wrapper">
                <canvas id="histOtherChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Shift Statistics Summary -->
    <div class="history-table-wrapper">
        <table class="data-table" id="shiftStatsTable">
            <thead>
                <tr>
                    <th>Ca</th>
                    <th>Thời gian</th>
                    <th style="color:#2DA44E">% Chạy</th>
                    <th style="color:#D4990A">% Chờ</th>
                    <th style="color:#CF222E">% Dừng</th>
                    <th style="color:#8B95A5">Tắt (phút)</th>
                    <th style="color:#2F81F7" title="@ErrorNames.Full(ErrorType.Out)">% @ErrorNames.Short(ErrorType.Out)</th>
                    <th style="color:#F85149" title="@ErrorNames.Full(ErrorType.Trash)">% @ErrorNames.Short(ErrorType.Trash)</th>
                    <th style="color:#A371F7" title="@ErrorNames.Full(ErrorType.Other)">% @ErrorNames.Short(ErrorType.Other)</th>
                </tr>
            </thead>
            <tbody id="shiftStatsBody">
                <tr><td colspan="9" class="empty-row">Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
        <div style="font-size:12px; color:var(--text-muted); margin-top:6px">% tính trên thời gian có đèn (Chạy + Chờ + Dừng), không tính thời gian Tắt máy.</div>
    </div>
</div>

@section Scripts {
<script>
    // Chart color constants for light theme
    const C = {
        green: '#3FB950',
        yellow: '#D4990A',
        red: '#F85149',
        gray: '#8B949E',
        out: '#2F81F7', trash: '#F85149', other: '#A371F7',
        line: '#37474F', // the one colour of the status line
        grid: 'rgba(0, 0, 0, 0.05)', text: '#656D76'
    };

    // Disable animations globally
    Chart.defaults.animation = false;
    Chart.defaults.transitions.active.animation.duration = 0;

    let histStatusChart;
    const errorCharts = {}; // canvas id → Chart
    const historyState = pageState('history');

    // Same y-axis width on every chart so the time axes line up vertically
    const Y_AXIS_WIDTH = 48;
    const fixYAxisWidth = scale => { scale.width = Y_AXIS_WIDTH; };

    function allCharts() {
        return [histStatusChart, ...Object.values(errorCharts)].filter(Boolean);
    }

    // Zoom/pan on one chart → the same time range on all charts
    function syncTimeRange({ chart }) {
        const { min, max } = chart.scales.x;
        allCharts().forEach(c => { if (c !== chart) c.zoomScale('x', { min, max }, 'none'); });
    }

    // Double-click any chart → back to the picked Từ – Đến range on all charts
    function resetTimeRange() {
        allCharts().forEach(c => c.resetZoom('none'));
    }

    function zoomOptions(range) {
        return {
            zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x', onZoom: syncTimeRange },
            pan: { enabled: true, mode: 'x', onPan: syncTimeRange },
            limits: { x: { min: range.start.getTime(), max: range.end.getTime() } }
        };
    }

    // Local midnight of the picked date (new Date("yyyy-mm-dd") would be UTC midnight)
    function pickedDate() {
        const dateStr = document.getElementById('histDate').value;
        if (!dateStr) { const d = new Date(); d.setHours(0, 0, 0, 0); return d; }
        const [y, m, d] = dateStr.split('-').map(Number);
        return new Date(y, m - 1, d);
    }

    // Shift time range: Ca1=06:00, Ca3 end=06:00 next day
    function getShiftRange() {
        const d = pickedDate();
        const start = new Date(d); start.setHours(6, 0, 0, 0);
        const end = new Date(d); end.setDate(end.getDate() + 1); end.setHours(6, 0, 0, 0);
        return { start, end };
    }

    // 24-hour time pickers: hour 00–23 : minute 00–59 (the browser's own time input follows the Windows language
    // and may show AM/PM). Value "HH:mm"; the picker of id X is the selects XH and XM
    const pad2 = n => String(n).padStart(2, '0');
    ['histFrom', 'histTo'].forEach(id => {
        document.getElementById(id + 'H').innerHTML = Array.from({ length: 24 }, (_, h) => `<option>${pad2(h)}</option>`).join('');
        document.getElementById(id + 'M').innerHTML = Array.from({ length: 60 }, (_, m) => `<option>${pad2(m)}</option>`).join('');
        setTime24(id, '06:00');
    });

    function getTime24(id) {
        return document.getElementById(id + 'H').value + ':' + document.getElementById(id + 'M').value;
    }

    // An invalid value (e.g. a broken saved state) leaves the picker as it was
    function setTime24(id, value) {
        if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(value ?? '')) return;
        const [h, m] = value.split(':');
        document.getElementById(id + 'H').value = h;
        document.getElementById(id + 'M').value = m;
    }

    // The Từ – Đến range shown on the charts, inside the production day (06:00 → 06:00 next day):
    // a time before 06:00 is on the next calendar day, and Đến 06:00 is the end of the day. null = Đến not after Từ
    function getViewRange() {
        const day = getShiftRange();
        const at = (value, isEnd) => {
            const [h, m] = (value || '06:00').split(':').map(Number);
            const d = new Date(day.start);
            d.setHours(h, m, 0, 0);
            if (h < 6 || (isEnd && h === 6 && m === 0)) d.setDate(d.getDate() + 1);
            return d;
        };
        const start = at(getTime24('histFrom'), false);
        const end = at(getTime24('histTo'), true);
        return end > start ? { start, end } : null;
    }

    // Time ticks on round local times for the range on screen (also while zoomed): every 1, 2, 5 … 180 min, ≤ ~12 steps
    const TICK_STEPS_MIN = [1, 2, 5, 10, 15, 30, 60, 120, 180];
    function roundTimeTicks(axis) {
        const spanMin = (axis.max - axis.min) / 60000;
        const step = (TICK_STEPS_MIN.find(s => spanMin / s <= 12) ?? 180) * 60000;
        const tz = new Date(axis.min).getTimezoneOffset() * 60000;
        const ticks = [];
        for (let t = Math.ceil((axis.min - tz) / step) * step + tz; t <= axis.max; t += step) ticks.push({ value: t });
        axis.ticks = ticks;
    }

    // Time axis of the Từ – Đến range shown
    function timeAxis(view) {
        return {
            type: 'time',
            min: view.start,
            max: view.end,
            afterBuildTicks: roundTimeTicks,
            time: { minUnit: 'minute', displayFormats: { minute: 'HH:mm', hour: 'HH:mm', day: 'HH:mm' }, tooltipFormat: 'HH:mm:ss' },
            ticks: { color: C.text, font: { size: 10 } },
            grid: { color: C.grid }
        };
    }

    // Factory local time as the API expects it: yyyy-MM-ddTHH:mm:ss (no time zone)
    function toLocalIso(d) {
        const p = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
    }

    function formatDuration(seconds) {
        if (!seconds || seconds <= 0) return '—';
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = Math.floor(seconds % 60);
        if (h > 0) return `${h}h ${m}m ${s}s`;
        if (m > 0) return `${m}m ${s}s`;
        return `${s}s`;
    }

    async function loadHistory() {
        const machineId = document.getElementById('histMachineId').value;
        const range = getShiftRange();
        const from = getTime24('histFrom'), to = getTime24('histTo');
        historyState.save({ machineId, date: document.getElementById('histDate').value, from, to });
        document.querySelectorAll('.range-btn').forEach(b => b.classList.toggle('on', b.dataset.range === `${from}-${to}`));
        const view = getViewRange();
        document.getElementById('histRangeError').textContent =
            view ? '' : 'Giờ "Đến" phải sau giờ "Từ" (ngày sản xuất 06:00 → 06:00 hôm sau)';
        if (!view) return;

        try {
            // Load chart data for the whole production day, 06:00 → 06:00 next day (the shift table needs all of it)
            const chartResp = await fetch(`/api/machineapi/chart-data?machineId=${machineId}&from=${toLocalIso(range.start)}&to=${toLocalIso(range.end)}`);
            const chartData = await chartResp.json();

            renderStatusChart(chartData.statusTimeline, view);
            renderErrorTimeline('histOutChart', chartData.errorTimeline, 'outError', C.out, ERROR_NAMES.out.short, view);
            renderErrorTimeline('histTrashChart', chartData.errorTimeline, 'trashError', C.trash, ERROR_NAMES.trash.short, view);
            renderErrorTimeline('histOtherChart', chartData.errorTimeline, 'otherError', C.other, ERROR_NAMES.other.short, view);
            renderErrorLabels(chartData.errorTimeline, view);

            // Calculate per-shift statistics
            renderShiftStats(chartData.statusTimeline, chartData.errorTimeline);
        } catch (e) {
            console.error('Failed to load history:', e);
        }
    }

    function renderShiftStats(statusTimeline, errorTimeline) {
        const tbody = document.getElementById('shiftStatsBody');
        const baseDate = pickedDate();

        // Shift boundaries
        const shifts = [
            { name: 'Ca 1', startH: 6, endH: 14, label: '06:00 – 14:00' },
            { name: 'Ca 2', startH: 14, endH: 22, label: '14:00 – 22:00' },
            { name: 'Ca 3', startH: 22, endH: 30, label: '22:00 – 06:00' }  // 30 = next day 06:00
        ];

        const SHIFT_SEC = 8 * 3600; // 8 hours per shift
        const TOTAL_SEC = 24 * 3600;

        // For each shift, accumulate seconds per status and per error
        const results = shifts.map(shift => {
            const shiftStart = new Date(baseDate);
            shiftStart.setHours(shift.startH % 24, 0, 0, 0);
            if (shift.startH >= 24) shiftStart.setDate(shiftStart.getDate() + 1);

            const shiftEnd = new Date(baseDate);
            shiftEnd.setHours(shift.endH % 24, 0, 0, 0);
            if (shift.endH >= 24) shiftEnd.setDate(shiftEnd.getDate() + 1);

            let green = 0, yellow = 0, red = 0, off = 0;
            let outSec = 0, trashSec = 0, otherSec = 0;

            // Status durations
            statusTimeline.forEach(t => {
                const segStart = new Date(t.start);
                const segEnd = new Date(t.end);
                const overlap = getOverlap(segStart, segEnd, shiftStart, shiftEnd);
                if (overlap <= 0) return;

                if (t.status === 'Green') green += overlap;
                else if (t.status === 'Yellow') yellow += overlap;
                else if (t.status === 'Red') red += overlap;
                else if (t.status === 'Off') off += overlap;
            });

            // Error durations
            errorTimeline.forEach(t => {
                const segStart = new Date(t.start);
                const segEnd = new Date(t.end);
                const overlap = getOverlap(segStart, segEnd, shiftStart, shiftEnd);
                if (overlap <= 0) return;

                if (t.outError) outSec += overlap;
                if (t.trashError) trashSec += overlap;
                if (t.otherError) otherSec += overlap;
            });

            const total = green + yellow + red + off;
            return {
                name: shift.name, label: shift.label,
                green, yellow, red, off, total,
                outSec, trashSec, otherSec,
                shiftSec: SHIFT_SEC
            };
        });

        // Total row
        const totals = {
            name: '<strong>Tổng</strong>', label: '06:00 – 06:00',
            green: results.reduce((s, r) => s + r.green, 0),
            yellow: results.reduce((s, r) => s + r.yellow, 0),
            red: results.reduce((s, r) => s + r.red, 0),
            off: results.reduce((s, r) => s + r.off, 0),
            total: results.reduce((s, r) => s + r.total, 0),
            outSec: results.reduce((s, r) => s + r.outSec, 0),
            trashSec: results.reduce((s, r) => s + r.trashSec, 0),
            otherSec: results.reduce((s, r) => s + r.otherSec, 0),
            shiftSec: TOTAL_SEC
        };

        const allRows = [...results, totals];

        function pct(val, base) {
            if (base <= 0) return '—';
            return (val / base * 100).toFixed(1) + '%';
        }

        function pctCell(val, base, color) {
            const p = base > 0 ? (val / base * 100) : 0;
            return `<td style="text-align:center; color:${p > 0 ? color : 'inherit'}; font-weight:${p > 0 ? '600' : '400'}">${pct(val, base)}</td>`;
        }

        tbody.innerHTML = allRows.map((r, i) => {
            const isTotal = i === allRows.length - 1;
            const rowStyle = isTotal ? 'style="border-top:2px solid var(--border-strong); font-weight:600"' : '';
            // Same base as the Report page (Models/ProductionRate.cs): lamp-on time, power-off not included
            const base = r.green + r.yellow + r.red;
            return `<tr ${rowStyle}>
                <td>${r.name}</td>
                <td style="color:var(--text-muted); font-size:11px">${r.label}</td>
                ${pctCell(r.green, base, C.green)}
                ${pctCell(r.yellow, base, C.yellow)}
                ${pctCell(r.red, base, C.red)}
                <td style="text-align:center; color:${r.off > 0 ? C.gray : 'inherit'}">${Math.round(r.off / 60)}</td>
                ${pctCell(r.outSec, base, C.out)}
                ${pctCell(r.trashSec, base, C.trash)}
                ${pctCell(r.otherSec, base, C.other)}
            </tr>`;
        }).join('');
    }

    // Error chart headings: share of the Từ – Đến range shown
    function renderErrorLabels(errorTimeline, view) {
        const total = (view.end - view.start) / 1000;
        const pctOf = key => (errorTimeline
            .reduce((s, t) => s + (t[key] ? getOverlap(new Date(t.start), new Date(t.end), view.start, view.end) : 0), 0) / total * 100).toFixed(1);
        document.getElementById('labelOut').innerHTML = `🔵 ${ERROR_NAMES.out.full} — <span style="color:${C.out}">${pctOf('outError')}%</span>`;
        document.getElementById('labelTrash').innerHTML = `🔴 ${ERROR_NAMES.trash.full} — <span style="color:${C.trash}">${pctOf('trashError')}%</span>`;
        document.getElementById('labelOther').innerHTML = `🟣 ${ERROR_NAMES.other.full} — <span style="color:${C.other}">${pctOf('otherError')}%</span>`;
    }

    // Get overlap in seconds between two time ranges
    function getOverlap(s1, e1, s2, e2) {
        const start = Math.max(s1.getTime(), s2.getTime());
        const end = Math.min(e1.getTime(), e2.getTime());
        return Math.max(0, (end - start) / 1000);
    }

    // === Status chart ===
    function renderStatusChart(timeline, view) {
        const ctx = document.getElementById('historyStatusChart').getContext('2d');
        if (histStatusChart) histStatusChart.destroy();

        const statusY = { 'Green': 3, 'Yellow': 2, 'Red': 1, 'Off': 0 };

        // One line through all segments (like the original app): vertical at each change, broken over a gap > 2 s
        const points = [];
        let lastEnd = null;

        // Seconds per status inside the range shown, for the legend percentages
        const seconds = { 'Green': 0, 'Yellow': 0, 'Red': 0, 'Off': 0 };
        const TOTAL_SEC = (view.end - view.start) / 1000;

        timeline.forEach(t => {
            const yVal = statusY[t.status];
            if (yVal === undefined) return;
            const startDate = new Date(t.start);
            const endDate = new Date(t.end);
            seconds[t.status] += getOverlap(startDate, endDate, view.start, view.end);

            if (lastEnd !== null && startDate - lastEnd > 2000) points.push({ x: lastEnd, y: NaN });
            points.push({ x: startDate, y: yVal });
            points.push({ x: endDate, y: yVal });
            lastEnd = endDate;
        });

        // Legend = text only (no colour boxes): share of the range shown per status
        const legendItems = [['Green', 'Chạy', C.green], ['Yellow', 'Chờ', C.yellow], ['Red', 'Dừng', C.red], ['Off', 'Tắt', C.gray]]
            .map(([status, name, color]) => ({
                text: `${name} ${(seconds[status] / TOTAL_SEC * 100).toFixed(1)}%`,
                fontColor: color, fillStyle: 'transparent', strokeStyle: 'transparent', lineWidth: 0
            }));

        const shiftRange = getShiftRange();

        histStatusChart = new Chart(ctx, {
            type: 'line',
            data: {
                datasets: [{
                    label: 'Trạng thái',
                    data: points,
                    borderColor: C.line,
                    borderWidth: 2,
                    fill: false,
                    stepped: true,
                    spanGaps: false,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                interaction: { mode: 'none' },
                plugins: {
                    legend: {
                        display: true, position: 'top', onClick: null,
                        labels: { boxWidth: 0, font: { size: 11 }, padding: 12, generateLabels: () => legendItems }
                    },
                    tooltip: timeTooltip,
                    zoom: zoomOptions(shiftRange)
                },
                scales: {
                    x: timeAxis(view),
                    y: {
                        min: -0.3, max: 3.5,
                        afterFit: fixYAxisWidth,
                        afterBuildTicks: fixedTicks(0, 1, 2, 3),
                        ticks: {
                            color: C.text, stepSize: 1, font: { size: 10 },
                            callback: v => { if (v >= 0 && v <= 3) return ['Tắt', 'Dừng', 'Chờ', 'Chạy'][v]; return ''; }
                        },
                        grid: { color: C.grid }
                    }
                }
            }
        });
    }

    // === Error timeline chart ===
    function renderErrorTimeline(canvasId, errorTimeline, errorKey, color, label, view) {
        const ctx = document.getElementById(canvasId).getContext('2d');
        if (errorCharts[canvasId]) errorCharts[canvasId].destroy();

        const shiftRange = getShiftRange();

        // The line ends at "now" when the day is still running
        const now = new Date();
        const points = errorLinePoints(errorTimeline, errorKey, shiftRange.start, now < shiftRange.end ? now : shiftRange.end);

        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                datasets: [{
                    label: label,
                    data: points,
                    borderColor: color,
                    borderWidth: 2,
                    fill: false,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                interaction: { mode: 'none' },
                plugins: {
                    legend: { display: false },
                    tooltip: timeTooltip,
                    zoom: zoomOptions(shiftRange)
                },
                scales: {
                    x: timeAxis(view),
                    y: {
                        min: -0.1, max: 1.3,
                        afterFit: fixYAxisWidth,
                        afterBuildTicks: fixedTicks(0, 1),
                        ticks: {
                            color: C.text, stepSize: 1, font: { size: 10 },
                            callback: v => v === 0 ? 'OFF' : v === 1 ? 'ON' : ''
                        },
                        grid: { color: C.grid }
                    }
                }
            }
        });

        errorCharts[canvasId] = chart;
    }

    ['historyStatusChart', 'histOutChart', 'histTrashChart', 'histOtherChart']
        .forEach(id => document.getElementById(id).addEventListener('dblclick', resetTimeRange));

    // Quick ranges: whole day or one shift
    document.querySelectorAll('.range-btn').forEach(b => b.addEventListener('click', () => {
        const [from, to] = b.dataset.range.split('-');
        setTime24('histFrom', from);
        setTime24('histTo', to);
        loadHistory();
    }));

    // Initial load, with the machine, day and Từ – Đến picked before switching pages
    const saved = historyState.get();
    restoreControl('histMachineId', saved.machineId);
    restoreControl('histDate', saved.date);
    setTime24('histFrom', saved.from);
    setTime24('histTo', saved.to);
    loadHistory();
</script>
}
