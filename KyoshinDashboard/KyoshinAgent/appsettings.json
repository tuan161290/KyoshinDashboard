{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Plc": {
    "ComPort": "COM5",
    "BaudRate": 38400,
    "PollingIntervalMs": 500,
    "OnConfirmSeconds": 3,
    "OffConfirmSeconds": 3,
    "UseMock": true,
    "Command": "WR",
    "SumCheck": false
  },
  "Server": {
    "Url": "http://127.0.0.1:5000",
    "ApiKey": "",
    "HeartbeatSeconds": 10,
    "BatchSize": 500
  },
  "Agent": {
    "DataFile": "agent.db"
  }
}
